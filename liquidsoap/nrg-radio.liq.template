# NRG Radio 1.2.0 - generated by install.sh
settings.log.stdout := true

def get_next() =
  path = string.trim(process.read("/opt/nrg-radio/venv/bin/python /opt/nrg-radio/app/next_item.py"))
  if path == "" then null else request.create(path) end
end

radio = request.dynamic(id="nrg_dynamic", prefetch=1, retry_delay=2., get_next)
emergency = single("/opt/nrg-radio/assets/emergency.mp3")
radio = fallback(track_sensitive=false, [radio, emergency])
radio = normalize(radio)
output.icecast(
  %mp3(bitrate=96, samplerate=44100, stereo=true),
  host="__CASTER_HOST__", port=__CASTER_PORT__, user="__CASTER_USER__",
  password="__CASTER_PASSWORD__", mount="__CASTER_MOUNT__",
  name="NRG Radio", description="NRG Radio - AI radio vanaf lokale muziekbron",
  genre="Various", radio
)
